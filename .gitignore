# Python caches and test tooling
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# uv / local environments
.venv/
.env
.env.*
!.env.example

# Build and packaging output
build/
dist/
*.egg-info/

# IDE and operating-system files
.vscode/
.idea/
.DS_Store
*.swp
*.swo

# Local logs and temporary experiment files
*.log
experiments/results/**/_*smoke*/
experiments/results/**/checkpoint-*/
wandb/
runs/
mlruns/
tensorboard/
*.tfevents.*

# Generated dataset snapshots; manifests remain versioned for provenance
experiments/data/**/*.jsonl
experiments/data/**/*.parquet
experiments/data/**/*.arrow
experiments/data/**/*.npy
experiments/data/**/*.npz
!experiments/data/fineweb_cc-main-2025-26.jsonl

# Model checkpoints and adapter weights are reproducible artifacts, not source
experiments/results/**/adapters/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx
*.msgpack

# Local literature and research notes
/papers/
/research/
